rules_version = '2';

// PokerPal Firestore security rules.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    /* ─────────────────────  Helpers  ───────────────────── */

    function signedIn() {
      return request.auth != null;
    }

    // Fields changed by this update.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Valid iff the caller is only adding/removing THEMSELVES to `followers`.
    function followersChangeIsValid() {
      let before = resource.data.get('followers', []);
      let after = request.resource.data.get('followers', []);
      let uid = request.auth.uid;

      let isFollow =
        !before.hasAny([uid]) &&
        after.hasAny([uid]) &&
        after.size() == before.size() + 1 &&
        after.hasAll(before);

      let isUnfollow =
        before.hasAny([uid]) &&
        !after.hasAny([uid]) &&
        before.size() == after.size() + 1 &&
        before.hasAll(after);

      return isFollow || isUnfollow;
    }

    /* ─────────────────────  USER PROFILES  ───────────────────── */
    match /users/{userId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == userId;

      // Owners can edit their own profile, EXCEPT:
      //  - `tournaments` — the legacy results-history field (the history now
      //    lives in `stats/{uid}`; this stays excluded so a client can never
      //    reintroduce or edit it),
      //  - `featuredResults` — the public showcase, written only by the API
      //    (PUT /users/me/featured), which copies place and winnings from the
      //    real finalized standings. Client-writable, a player could invent
      //    a first place.
      //
      // Anyone else may only follow/unfollow (add or remove themselves from
      // `followers`).
      allow update: if signedIn() && (
        (request.auth.uid == userId &&
          !changedKeys().hasAny(['tournaments', 'featuredResults'])) ||
        (changedKeys().hasOnly(['followers']) && followersChangeIsValid())
      );
    }

    /* ─────────────────────  STATS (private history)  ───────────────────── */
    // A player's full results history — every buy-in, rebuy and payout. This
    // used to be a field on the public profile doc, readable by any signed-in
    // user; it now lives here so only its owner can read it. All writes go
    // through the API (Admin SDK, bypasses these rules).
    match /stats/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    /* ─────────────────────  TOURNAMENTS  ───────────────────── */
    // Read-only for clients. Every write — create, edit, delete, join, leave,
    // participant changes and finalization — goes through the REST API, which
    // enforces organizer-only access itself and settles the player-limit race
    // in a transaction.
    //
    // The Admin SDK bypasses these rules entirely, so this block constrains
    // only the clients; the API's own authorization checks are what protect
    // the data served over REST.
    //
    // `list` is denied outright. Nothing in either client queries this
    // collection directly — all browsing goes through GET /tournaments — and
    // leaving it open meant any signed-in user could enumerate every
    // tournament, private ones included, straight from the client SDK. That
    // was a bigger hole than the id-guessing one, because it needed no id.
    //
    // `get` is limited to people who already belong to the tournament. Code
    // holders are deliberately NOT covered here: a security rule cannot check
    // a code the client would have to supply, and code-based access is served
    // by the API instead.
    //
    // Two direct reads depend on this rule, both organizer-only in practice
    // and both covered by the createdBy clause:
    //   - players_screen.dart  reads tournaments/{id} to seed the roster
    //   - tournament_clock_screen.dart reads it to seed and name the clock doc
    // The React clock reads `timers`, never this collection, so the TV display
    // is unaffected.
    match /tournaments/{tId} {
      allow get: if signedIn() && (
        // A get on a document that does not exist returns "doesn't exist"
        // rather than a permission error, which is what the clock screen
        // checks for.
        resource == null ||
        resource.data.get('isPublic', false) == true ||
        resource.data.get('createdBy', '') == request.auth.uid ||
        request.auth.uid in resource.data.get('participants', [])
      );
      allow list: if false;
      allow write: if false;
    }

    /* ──────────────  TIMERS (blinds clock)  ────────────── */
    match /timers/{timerId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() &&
        resource.data.createdBy == request.auth.uid;
    }

    /* ──────────────  DISPLAYS (phone → TV remote control)  ────────────── */
    // A tiny real-time control doc: the organizer's phone sets which display
    // tab the TV shows and bumps a refresh signal; the web display subscribes
    // and follows. Same shape as timers — any signed-in user may read (the TV
    // and any viewer follow along), only the doc's creator (the organizer)
    // writes. This is a deliberate real-time exception, like the clock.
    match /displays/{tournamentId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() &&
        resource.data.createdBy == request.auth.uid;
    }

    /* ──────────────  SEATINGS (published seating charts)  ────────────── */
    // API-only, like tournaments: the organizer app publishes a chart through
    // POST /tournaments/:id/seating and the web display reads it through
    // GET /tournaments/:id/seating (Admin SDK, which ignores these rules). No
    // client touches the collection directly, and a chart carries player names,
    // so all direct access is denied.
    match /seatings/{tournamentId} {
      allow read, write: if false;
    }

    /* ──────────────  ROSTERS (players lists / payments)  ────────────── */
    // Private to the owner (organizer / creator of the saved list).
    match /rosters/{rosterId} {
      // resource == null lets a get on a not-yet-created doc succeed (returns
      // "doesn't exist") so the app can then create it. Queries still require
      // the ownerId filter, so this leaks nothing.
      allow read: if signedIn() &&
        (resource == null || resource.data.ownerId == request.auth.uid);
      allow update, delete: if signedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
    }

    /* ──────────────  GROUPS (regulars, real users + guests)  ────────────── */
    // Invitee accepts (self: pendingInvites -> memberUids) or declines
    // (self: removed from pendingInvites only).
    function inviteResponseIsValid() {
      let uid = request.auth.uid;
      let beforePending = resource.data.get('pendingInvites', []);
      let afterPending = request.resource.data.get('pendingInvites', []);
      let beforeMembers = resource.data.get('memberUids', []);
      let afterMembers = request.resource.data.get('memberUids', []);
      let selfRemovedFromPending =
        beforePending.hasAny([uid]) &&
        !afterPending.hasAny([uid]) &&
        afterPending.size() == beforePending.size() - 1;
      let accept =
        selfRemovedFromPending &&
        changedKeys().hasOnly(['pendingInvites', 'memberUids']) &&
        afterMembers.hasAny([uid]) &&
        afterMembers.size() == beforeMembers.size() + 1;
      let decline =
        selfRemovedFromPending &&
        changedKeys().hasOnly(['pendingInvites']) &&
        afterMembers.size() == beforeMembers.size();
      return accept || decline;
    }

    // A non-owner member removes only themselves from memberUids.
    function memberLeaveIsValid() {
      let uid = request.auth.uid;
      let before = resource.data.get('memberUids', []);
      let after = request.resource.data.get('memberUids', []);
      return uid != resource.data.ownerId &&
        changedKeys().hasOnly(['memberUids']) &&
        before.hasAny([uid]) &&
        !after.hasAny([uid]) &&
        before.size() == after.size() + 1 &&
        before.hasAll(after);
    }

    // The REST API also exposes these operations (/groups/...), but unlike
    // tournaments the mobile client still reads and writes groups directly:
    // an invite has to appear for the invitee without them refreshing, which
    // needs a live listener. The rules below therefore remain the real
    // enforcement for group writes.
    match /groups/{groupId} {
      // Readable by the owner, current members, and anyone with a pending
      // invite (so they can see what they're being invited into).
      allow read: if signedIn() && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid in resource.data.pendingInvites
      );
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberUids.hasAll([request.auth.uid]);
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        inviteResponseIsValid() ||
        memberLeaveIsValid()
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
